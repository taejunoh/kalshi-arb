{
  "expo": {
    "name": "Softbook +EV",
    "slug": "softbook-ev",
    "version": "1.0.1",
    "scheme": "softbook",
    "orientation": "portrait",
    "platforms": [
      "ios"
    ],
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.taejun.softbookev",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "베팅 슬립 캡처를 위해 카메라/사진 접근이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "베팅 슬립 캡처를 위해 카메라/사진 접근이 필요합니다.",
        "LSApplicationQueriesSchemes": [
          "dksb",
          "fanduel",
          "draftkings"
        ]
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#7C3AED"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "bb63465c-1e8f-414e-9ff8-2585cf778942"
      }
    },
    "owner": "allinsimple"
  }
}
