[Unit]
Description=Phase 0 cross-venue observer 1-week eval (one-shot)
After=network.target kalshi-bot.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/kalshi-arb
ExecStart=/home/ubuntu/kalshi-arb/venv/bin/python scripts/phase0_observer_eval_alarm.py
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

# Security (same pattern as kalshi-data-quality.service)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/kalshi-arb/data /home/ubuntu/kalshi-arb/logs
