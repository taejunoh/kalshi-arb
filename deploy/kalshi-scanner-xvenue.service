[Unit]
Description=Phase 0 prevalence scanner — B1 xvenue Polymarket signals (60s loop, no fires)
After=network.target kalshi-bot.service kalshi-polymarket-quote.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/kalshi-arb
ExecStart=/home/ubuntu/kalshi-arb/venv/bin/python scripts/research/xvenue_signal_scanner.py --interval 300
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/kalshi-arb/data /home/ubuntu/kalshi-arb/logs

[Install]
WantedBy=multi-user.target
