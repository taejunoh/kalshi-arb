[Unit]
Description=Hourly soft-book +EV paper place+settle (dashboard History freshness)
Requires=kalshi-ev-place.service

[Timer]
# :05/:25/:45 = right after each refresh scan (:00/:20/:40, which now also
# records to ev.db) so a pick shown on the +EV tab lands in the History ledgers
# within ~5 minutes. place()/place_high() are idempotent (deterministic from
# ev.db snapshots) — cadence changes NOTHING about the measured ledger, only
# dashboard freshness. The 13:00 UTC kalshi-ev-paper run stays the only one
# that pushes a Telegram digest.
OnCalendar=*-*-* *:05,25,45:00 UTC
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
