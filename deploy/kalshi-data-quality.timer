[Unit]
Description=Daily Kalshi sports observer data quality monitor
Requires=kalshi-data-quality.service

[Timer]
# Fire daily at 10:45 UTC — 30 min after the 10:15 UTC settlement backfill,
# so data_quality reports include freshly-settled tickers in lag stats.
OnCalendar=*-*-* 10:45:00 UTC
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
