[Unit]
Description=Daily eval gate for deribit_tail_fade_high_v1 paper trader — retire/promote check
After=network.target kalshi-bot.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/kalshi-arb
EnvironmentFile=/home/ubuntu/kalshi-arb/.env
ExecStart=/home/ubuntu/kalshi-arb/venv/bin/python scripts/deribit_tail_fade_high_v1_daily_eval.py --send
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

# Security (mirrors kalshi-daily-live-audit.service)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/kalshi-arb/data /home/ubuntu/kalshi-arb/logs
