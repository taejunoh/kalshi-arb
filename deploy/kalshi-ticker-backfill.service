[Unit]
Description=Kalshi ticker settlement backfill (one-shot)
After=network.target kalshi-bot.service
# After= alone (not Requires=/Wants=) — backfill should not start before
# kalshi-bot has finished its DB schema migrations to avoid a SQLite write-
# lock race that crashed the bot on AWS-initiated reboot 2026-05-05. Without
# this ordering, both processes started within 1s of each other on boot,
# the backfill grabbed the write lock first, and the bot's initialize()
# DDL commit hit "database is locked".

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/kalshi-arb
ExecStart=/home/ubuntu/kalshi-arb/venv/bin/python scripts/backfill_ticker_settlements.py
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

# Security (same pattern as kalshi-bot.service)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/kalshi-arb/data /home/ubuntu/kalshi-arb/logs
