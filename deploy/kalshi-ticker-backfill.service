[Unit]
Description=Kalshi ticker settlement backfill (one-shot)
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/kalshi-arb
ExecStart=/home/ubuntu/kalshi-arb/venv/bin/python scripts/backfill_ticker_settlements.py
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

# Security (same pattern as kalshi-bot.service)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/kalshi-arb/data /home/ubuntu/kalshi-arb/logs
