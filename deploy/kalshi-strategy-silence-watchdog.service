[Unit]
Description=Daily strategy silence watchdog — Telegram alert when LIVE strategy stops firing
After=network.target kalshi-bot.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/kalshi-arb
EnvironmentFile=/home/ubuntu/kalshi-arb/.env
ExecStart=/home/ubuntu/kalshi-arb/venv/bin/python scripts/strategy_silence_watchdog.py
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

# Security (mirrors kalshi-daily-live-audit.service)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/kalshi-arb/data /home/ubuntu/kalshi-arb/logs
