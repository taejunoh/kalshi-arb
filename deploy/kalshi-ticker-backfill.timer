[Unit]
Description=Daily Kalshi ticker settlement backfill
Requires=kalshi-ticker-backfill.service

[Timer]
# Fire 4x/day at 00:15, 06:15, 12:15, 18:15 UTC. 2026-05-02: stepped up from
# 1x daily to keep settlement lag ≤ 6h, enabling end-of-week promotion-eval
# decisions on newly-added sports (NPB/KBO/EPL/LAL/BUN/MLS/UCL) where
# day-7 ROI estimates need same-day game settlements. :15 instead of :00
# to avoid the minute everyone defaults to.
OnCalendar=*-*-* 00,06,12,18:15:00 UTC
# Run on next boot if the last scheduled run was missed (e.g., host down).
Persistent=true
# Small random delay so repeated AWS instances don't hammer Kalshi at once.
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
