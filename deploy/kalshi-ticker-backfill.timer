[Unit]
Description=Daily Kalshi ticker settlement backfill
Requires=kalshi-ticker-backfill.service

[Timer]
# Fire once a day at 10:15 UTC (06:15 ET). 10:00 UTC aligns with the
# dashboard's "Today" cutoff (06:00 ET) — by 10:15 most overnight
# NBA/NHL playoff games and late MLB games have finalized on Kalshi.
# :15 instead of :00 to avoid the minute everyone defaults to.
OnCalendar=*-*-* 10:15:00 UTC
# Run on next boot if the last scheduled run was missed (e.g., host down).
Persistent=true
# Small random delay so repeated AWS instances don't hammer Kalshi at once.
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
