[Unit]
Description=Kalshi sport promotion eligibility evaluator (one-shot)
After=network.target kalshi-bot.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/kalshi-arb
ExecStart=/home/ubuntu/kalshi-arb/venv/bin/python scripts/promotion_eval.py
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

# Security (same pattern as kalshi-bot.service)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/kalshi-arb/data /home/ubuntu/kalshi-arb/logs
